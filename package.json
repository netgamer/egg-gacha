{
  "name": "egg-gacha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "신비한 알 뽑기 — 모바일 우선 가챠 룰렛",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && touch dist/.nojekyll",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "test": "node tools/test.mjs",
    "shots": "node tools/shots.mjs",
    "subpath": "node tools/subpath-test.mjs",
    "test:all": "node tools/test.mjs && node tools/dragon-test.mjs",
    "dragon": "node tools/dragon-test.mjs",
    "parts": "python3 tools/proto-art/pipeline.py parts",
    "shots:dragon": "node tools/dragon-shots.mjs",
    "parts:export": "python3 tools/proto-art/pipeline.py export",
    "parts:variants": "python3 tools/proto-art/gen.py",
    "parts:atlas": "python3 tools/proto-art/pipeline.py atlas",
    "parts:mix": "python3 tools/proto-art/pipeline.py mix",
    "parts:sheet": "python3 tools/proto-art/pipeline.py sheet",
    "live": "node tools/live-check.mjs"
  },
  "devDependencies": {
    "playwright": "1.61.1",
    "vite": "^7.3.6"
  }
}
